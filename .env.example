# Temporal Echoes - Configuration Template
# Copy this file to .env and customize as needed
# This is a template - actual values go in .env (which is gitignored)

# ============================================================
# Game Settings
# ============================================================

# Game title displayed in window/logs (quote values containing spaces)
GAME_TITLE="Temporal Echoes"

# Target frames/ticks per second (1-144)
FPS_TARGET=60

# Window dimensions in pixels (min: 640x480)
WINDOW_WIDTH=800
WINDOW_HEIGHT=600

# Run in fullscreen mode (true/false)
FULLSCREEN=false

# ============================================================
# Database Settings
# ============================================================

# Path to SQLite event store database
DATABASE_PATH=data/events.db

# Path to DuckDB analytics database
DUCKDB_PATH=data/analytics.duckdb

# ============================================================
# AI Settings (Phase 4+)
# ============================================================

# Active LLM backend: ollama (local, offline-capable) or anthropic (Claude API)
LLM_PROVIDER=ollama
# Also honored by the provider factory:
# TEMPORAL_LLM_PROVIDER=ollama

# --- Ollama ---
# Ollama API host:port
OLLAMA_HOST=localhost:11434

# LLM model name, tag included — a bare name resolves to :latest (e.g., llama3.2:3b, gemma3:4b)
LLM_MODEL=llama3.2:3b

# LLM request timeout in seconds (1.0-30.0)
LLM_TIMEOUT=5.0

# LLM temperature for creativity (0.0-2.0)
# Lower = more deterministic, Higher = more creative
LLM_TEMPERATURE=0.7

# --- Anthropic (only required when LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# Development Settings
# ============================================================

# Enable debug mode (verbose logging)
DEBUG_MODE=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
