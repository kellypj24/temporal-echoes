# Temporal Echoes Environment Configuration
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control

# ==========================================
# Ollama LLM Configuration
# ==========================================
OLLAMA_HOST=localhost:11434
LLM_MODEL=llama3.2
LLM_TIMEOUT=5.0

# Auto-pull models on Ollama container start (set to true for first run)
AUTO_PULL_MODELS=false
PULL_LLAMA32=true
PULL_GEMMA3=false

# ==========================================
# Game Configuration
# ==========================================
DEBUG=0
FULLSCREEN=0
SCREEN_WIDTH=960
SCREEN_HEIGHT=540
TARGET_FPS=60

# ==========================================
# Database Configuration
# ==========================================
EVENTS_DB_PATH=data/events.db
ANALYTICS_DB_PATH=data/analytics.duckdb

# ==========================================
# dbt Configuration
# ==========================================
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/temporal-echoes.log

# ==========================================
# Display Configuration (for Docker on Linux)
# ==========================================
# Uncomment if running with display on Linux
# DISPLAY=:0

# ==========================================
# AI Dungeon Master Tuning
# ==========================================
# Temperature: 0.0 (deterministic) to 1.0 (creative)
AI_TEMPERATURE=0.7
# Top-p sampling
AI_TOP_P=0.9
# Max tokens to generate per response
AI_MAX_TOKENS=512

