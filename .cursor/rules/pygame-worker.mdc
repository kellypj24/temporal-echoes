### Sprite Management

```python
from pathlib import Path

class SpriteCache:
    """Sprite loading and caching system."""
    
    def __init__(self, assets_dir: Path):
        self.assets_dir = assets_dir / "sprites"
        self._cache: Dict[str, pygame.Surface] = {}
    
    def load_sprite(self, sprite_key: str) -> pygame.Surface:
        """
        Load sprite with caching.
        
        Args:
            sprite_key: Sprite identifier (e.g., "player/idle_0")
            
        Returns:
            Pygame surface
        """
        if sprite_key in self._cache:
            return self._cache[sprite_key]
        
        # Load from disk
        sprite_path = self.assets_dir / f"{sprite_key}.png"
        
        if not sprite_path.exists():
            raise FileNotFoundError(f"Sprite not found: {sprite_path}")
        
        surface = pygame.image.load(str(sprite_path)).convert_alpha()
        self._cache[sprite_key] = surface
        
        return surface
    
    def load_sprite_sheet(
        self,
        sheet_key: str,
        tile_width: int,
        tile_height: int
    ) -> List[pygame.Surface]:
        """
        Load and parse sprite sheet.
        
        Args:
            sheet_key: Sheet identifier
            tile_width: Width of each sprite in pixels
            tile_height: Height of each sprite in pixels
            
        Returns:
            List of sprite surfaces
        """
        sheet_path = self.assets_dir / f"{sheet_key}.png"
        sheet = pygame.image.load(str(sheet_path)).convert_alpha()
        
        sprites = []
        sheet_width, sheet_height = sheet.get_size()
        
        for y in range(0, sheet_height, tile_height):
            for x in range(0, sheet_width, tile_width):
                sprite = sheet.subsurface(
                    pygame.Rect(x, y, tile_width, tile_height)
                )
                sprites.append(sprite)
        
        return sprites

@dataclass
class AnimationState:
    """Animation state for sprites."""
    frames: List[pygame.Surface]
    frame_duration: float  # Seconds per frame
    loop: bool = True
    current_frame: int = 0
    elapsed: float = 0.0
    
    def update(self, delta_time: float) -> None:
        """Update animation."""
        self.elapsed += delta_time
        
        if self.elapsed >= self.frame_duration:
            self.elapsed = 0.0
            self.current_frame += 1
            
            if self.current_frame >= len(self.frames):
                if self.loop:
                    self.current_frame = 0
                else:
                    self.current_frame = len(self.frames) - 1
    
    @property
    def current_surface(self) -> pygame.Surface:
        """Get current frame surface."""
        return self.frames[self.current_frame]
```

### Entity Rendering

```python
@dataclass
class SpriteEntity:
    """Entity with sprite rendering."""
    position: tuple[int, int]  # World coordinates
    sprite_key: str
    z_index: int = 0  # For sorting within layer
    
    def __init__(self, position: tuple[int, int], sprite_key: str):
        self.position = position
        self.sprite_key = sprite_key
        self._sprite_cache: Optional[SpriteCache] = None
    
    def render(self, surface: pygame.Surface, camera_x: int, camera_y: int) -> None:
        """Render entity sprite."""
        if not self._sprite_cache:
            raise RuntimeError("Sprite cache not set")
        
        sprite = self._sprite_cache.load_sprite(self.sprite_key)
        
        # Convert world coordinates to screen coordinates
        screen_x = self.position[0] - camera_x
        screen_y = self.position[1] - camera_y
        
        # Only render if in viewport
        if self._in_viewport(screen_x, screen_y, sprite, surface):
            surface.blit(sprite, (screen_x, screen_y))
    
    def _in_viewport(
        self,
        screen_x: int,
        screen_y: int,
        sprite: pygame.Surface,
        viewport: pygame.Surface
    ) -> bool:
        """Check if sprite is in viewport."""
        sprite_width, sprite_height = sprite.get_size()
        viewport_width, viewport_height = viewport.get_size()
        
        return (
            screen_x + sprite_width >= 0 and
            screen_x < viewport_width and
            screen_y + sprite_height >= 0 and
            screen_y < viewport_height
        )
```

### Tile Map Rendering

```python
@dataclass
class TileMap:
    """Tile-based map data."""
    width: int  # In tiles
    height: int  # In tiles
    tile_size: int
    tiles: List[List[int]]  # 2D array of tile IDs
    
    def __post_init__(self):
        if len(self.tiles) != self.height:
            raise ValueError("Tile rows don't match height")
        if any(len(row) != self.width for row in self.tiles):
            raise ValueError("Tile columns don't match width")

class TileMapRenderer:
    """Optimized tile map rendering."""
    
    def __init__(self, tile_map: TileMap, tileset_sprites: List[pygame.Surface]):
        self.tile_map = tile_map
        self.tileset = tileset_sprites
    
    def render(self, surface: pygame.Surface, camera_x: int, camera_y: int) -> None:
        """
        Render visible tiles only.
        
        Optimization: Only render tiles in viewport.
        """
        tile_size = self.tile_map.tile_size
        viewport_width, viewport_height = surface.get_size()
        
        # Calculate visible tile range
        start_tile_x = max(0, camera_x // tile_size)
        start_tile_y = max(0, camera_y // tile_size)
        end_tile_x = min(
            self.tile_map.width,
            (camera_x + viewport_width) // tile_size + 1
        )
        end_tile_y = min(
            self.tile_map.height,
            (camera_y + viewport_height) // tile_size + 1
        )
        
        # Render visible tiles
        for tile_y in range(start_tile_y, end_tile_y):
            for tile_x in range(start_tile_x, end_tile_x):
                tile_id = self.tile_map.tiles[tile_y][tile_x]
                
                if tile_id >= 0 and tile_id < len(self.tileset):
                    sprite = self.tileset[tile_id]
                    
                    screen_x = tile_x * tile_size - camera_x
                    screen_y = tile_y * tile_size - camera_y
                    
                    surface.blit(sprite, (screen_x, screen_y))
```

### UI Components

```python
@dataclass
class UIRect:
    """UI rectangle component."""
    x: int
    y: int
    width: int
    height: int
    color: tuple[int, int, int]
    border_color: Optional[tuple[int, int, int]] = None
    border_width: int = 2
    
    def render(self, surface: pygame.Surface, camera_x: int, camera_y: int) -> None:
        """Render UI rectangle (camera-independent)."""
        rect = pygame.Rect(self.x, self.y, self.width, self.height)
        
        # Fill
        pygame.draw.rect(surface, self.color, rect)
        
        # Border
        if self.border_color:
            pygame.draw.rect(
                surface,
                self.border_color,
                rect,
                self.border_width
            )

@dataclass
class UIText:
    """UI text component."""
    text: str
    x: int
    y: int
    font_name: str = "monospace"
    font_size: int = 16
    color: tuple[int, int, int] = (255, 255, 255)
    
    def __post_init__(self):
        self._font = pygame.font.SysFont(self.font_name, self.font_size)
    
    def render(self, surface: pygame.Surface, camera_x: int, camera_y: int) -> None:
        """Render text (camera-independent)."""
        text_surface = self._font.render(self.text, True, self.color)
        surface.blit(text_surface, (self.x, self.y))

class DialogBox:
    """Dialog box UI component."""
    
    def __init__(
        self,
        x: int,
        y: int,
        width: int,
        height: int,
        text: str
    ):
        self.rect = UIRect(
            x, y, width, height,
            color=(20, 20, 40),
            border_color=(255, 255, 255),
            border_width=3
        )
        self.text = UIText(
            text,
            x + 10,
            y + 10,
            font_size=14
        )
    
    def render(self, surface: pygame.Surface, camera_x: int, camera_y: int) -> None:
        """Render dialog box."""
        self.rect.render(surface, camera_x, camera_y)
        self.text.render(surface, camera_x, camera_y)
