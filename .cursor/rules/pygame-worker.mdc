### Performance Optimization

```python
class SpritePool:
    """Object pooling for sprites to reduce allocations."""
    
    def __init__(self, sprite_key: str, pool_size: int, sprite_cache: SpriteCache):
        self.sprite_key = sprite_key
        self._available: List[SpriteEntity] = []
        self._in_use: List[SpriteEntity] = []
        
        # Pre-allocate pool
        for _ in range(pool_size):
            entity = SpriteEntity((0, 0), sprite_key)
            entity._sprite_cache = sprite_cache
            self._available.append(entity)
    
    def acquire(self, position: tuple[int, int]) -> SpriteEntity:
        """Get entity from pool."""
        if self._available:
            entity = self._available.pop()
            entity.position = position
            self._in_use.append(entity)
            return entity
        
        # Pool exhausted, create new
        entity = SpriteEntity(position, self.sprite_key)
        self._in_use.append(entity)
        return entity
    
    def release(self, entity: SpriteEntity) -> None:
        """Return entity to pool."""
        if entity in self._in_use:
            self._in_use.remove(entity)
            self._available.append(entity)
```

## Input Handling

```python
class InputHandler:
    """Process Pygame input events."""
    
    def __init__(self):
        self.keys_pressed: Set[int] = set()
        self.keys_just_pressed: Set[int] = set()
        self.mouse_pos: tuple[int, int] = (0, 0)
        self.mouse_clicked: bool = False
    
    def process_events(self) -> bool:
        """
        Process Pygame events.
        
        Returns:
            False if quit event received
        """
        self.keys_just_pressed.clear()
        self.mouse_clicked = False
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            
            elif event.type == pygame.KEYDOWN:
                self.keys_pressed.add(event.key)
                self.keys_just_pressed.add(event.key)
            
            elif event.type == pygame.KEYUP:
                self.keys_pressed.discard(event.key)
            
            elif event.type == pygame.MOUSEMOTION:
                self.mouse_pos = event.pos
            
            elif event.type == pygame.MOUSEBUTTONDOWN:
                self.mouse_clicked = True
        
        return True
    
    def is_key_down(self, key: int) -> bool:
        """Check if key is currently held."""
        return key in self.keys_pressed
    
    def is_key_just_pressed(self, key: int) -> bool:
        """Check if key was just pressed this frame."""
        return key in self.keys_just_pressed
```

## 16-Bit Aesthetic Guidelines

### Color Palette
- Use limited color palettes (16-256 colors)
- Avoid gradients, use dithering instead
- High contrast for readability

### Sprite Design
- Pixel-perfect alignment (no sub-pixel positioning)
- Tile size: 32x32 or 16x16
- Character sprites: 32x32 to 48x48

### Effects
- Screen shake for impacts
- Flash on hit (color overlay)
- Fade transitions between states

