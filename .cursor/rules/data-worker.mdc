### Staging Models

```sql
-- dbt/models/staging/stg_combat_events.sql
{{ config(
    materialized='incremental',
    unique_key='combat_event_id',
    on_schema_change='append_new_columns'
) }}

WITH source AS (
    SELECT * FROM {{ source('sqlite_events', 'combat_events') }}
    {% if is_incremental() %}
    WHERE combat_event_id NOT IN (SELECT combat_event_id FROM {{ this }})
    {% endif %}
),

enriched AS (
    SELECT
        ce.combat_event_id,
        ce.game_event_id,
        ce.combat_session_id,
        ce.turn_number,
        ce.actor_id,
        ce.target_id,
        ce.action_type,
        ce.base_damage,
        ce.modified_damage,
        ce.combo_count,
        ce.is_critical,
        ge.event_timestamp,
        ge.timeline_id,
        ge.session_id
    FROM source ce
    INNER JOIN {{ source('sqlite_events', 'game_events') }} ge
        ON ce.game_event_id = ge.event_id
)

SELECT * FROM enriched
```

```sql
-- dbt/models/staging/stg_timeline_events.sql
{{ config(
    materialized='incremental',
    unique_key='event_id'
) }}

SELECT
    event_id,
    event_timestamp,
    session_id,
    timeline_id,
    event_type,
    player_id,
    player_action,
    JSON_EXTRACT(outcome, '$.success') AS action_success,
    JSON_EXTRACT(outcome, '$.consequence') AS consequence,
    ai_response IS NOT NULL AS ai_generated
FROM {{ source('sqlite_events', 'game_events') }}
{% if is_incremental() %}
WHERE event_timestamp > (SELECT MAX(event_timestamp) FROM {{ this }})
{% endif %}
```

### Intermediate Models

```sql
-- dbt/models/intermediate/int_combat_damage_analysis.sql
{{ config(materialized='table') }}

WITH combat_stats AS (
    SELECT
        combat_session_id,
        timeline_id,
        SUM(modified_damage) AS total_damage,
        AVG(modified_damage) AS avg_damage_per_turn,
        SUM(CASE WHEN is_critical THEN 1 ELSE 0 END) AS critical_hits,
        MAX(combo_count) AS max_combo,
        COUNT(*) AS total_turns
    FROM {{ ref('stg_combat_events') }}
    GROUP BY combat_session_id, timeline_id
),

combo_multipliers AS (
    SELECT
        combat_session_id,
        {{ calculate_combo_multiplier('max_combo') }} AS combo_multiplier
    FROM combat_stats
)

SELECT
    cs.*,
    cm.combo_multiplier,
    cs.total_damage * cm.combo_multiplier AS adjusted_damage
FROM combat_stats cs
LEFT JOIN combo_multipliers cm USING (combat_session_id)
```

### Analytics Models (Game-Ready)

```sql
-- dbt/models/analytics/player_satisfaction_trends.sql
{{ config(
    materialized='incremental',
    unique_key=['session_id', 'event_timestamp']
) }}

SELECT
    session_id,
    event_timestamp,
    timeline_id,
    event_type,
    player_action,
    CASE
        WHEN ai_generated AND action_success THEN 1.0
        WHEN ai_generated AND NOT action_success THEN 0.5
        WHEN NOT ai_generated THEN 0.8
    END AS satisfaction_score,
    CURRENT_TIMESTAMP AS processed_at
FROM {{ ref('stg_timeline_events') }}
{% if is_incremental() %}
WHERE event_timestamp > (SELECT MAX(event_timestamp) FROM {{ this }})
{% endif %}
```

```sql
-- dbt/models/analytics/timeline_divergence_metrics.sql
{{ config(materialized='table') }}

WITH timeline_tree AS (
    SELECT
        t.timeline_id,
        t.parent_timeline_id,
        t.divergence_timestamp,
        COUNT(DISTINCT ge.event_id) AS event_count,
        COUNT(DISTINCT ge.session_id) AS session_count
    FROM {{ source('sqlite_events', 'timelines') }} t
    LEFT JOIN {{ ref('stg_timeline_events') }} ge
        ON t.timeline_id = ge.timeline_id
    GROUP BY t.timeline_id, t.parent_timeline_id, t.divergence_timestamp
)

SELECT
    timeline_id,
    parent_timeline_id,
    divergence_timestamp,
    event_count,
    session_count,
    {{ timeline_divergence_modifier('event_count') }} AS divergence_modifier
FROM timeline_tree
```

### dbt Macros (Game Calculations)

```sql
-- dbt/macros/game_calculations.sql

{% macro calculate_combo_multiplier(combo_count) %}
    CASE
        WHEN {{ combo_count }} >= 10 THEN 2.5
        WHEN {{ combo_count }} >= 5 THEN 1.8
        WHEN {{ combo_count }} >= 3 THEN 1.3
        ELSE 1.0
    END
{% endmacro %}

{% macro timeline_divergence_modifier(divergence_score) %}
    POWER(1.5, {{ divergence_score }} / 10.0)
{% endmacro %}

{% macro calculate_critical_chance(base_chance, luck_stat, combo_count) %}
    LEAST(
        {{ base_chance }} + ({{ luck_stat }} * 0.02) + ({{ combo_count }} * 0.05),
        0.95
    )
{% endmacro %}
```

