## Python dbt Integration Bridge

```python
import subprocess
from pathlib import Path
from typing import List, Optional

class DBTBridge:
    """Bridge between game engine and dbt analytics."""
    
    def __init__(self, dbt_project_dir: str = "dbt"):
        self.project_dir = Path(dbt_project_dir)
        self.profiles_dir = self.project_dir.parent / ".dbt"
    
    def run_models(
        self,
        models: Optional[List[str]] = None,
        full_refresh: bool = False
    ) -> bool:
        """
        Run dbt models to refresh analytics.
        
        Args:
            models: Specific models to run (None = all)
            full_refresh: Force full refresh of incremental models
            
        Returns:
            True if successful
        """
        cmd = ["dbt", "run", "--project-dir", str(self.project_dir)]
        
        if models:
            for model in models:
                cmd.extend(["--select", model])
        
        if full_refresh:
            cmd.append("--full-refresh")
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        
        if result.returncode != 0:
            logger.error(f"dbt run failed: {result.stderr}")
            return False
        
        return True
    
    def test_models(self, models: Optional[List[str]] = None) -> bool:
        """Run dbt tests."""
        cmd = ["dbt", "test", "--project-dir", str(self.project_dir)]
        
        if models:
            for model in models:
                cmd.extend(["--select", model])
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        return result.returncode == 0
    
    def get_combat_metrics(self, combat_session_id: str) -> dict:
        """Query analytics for combat metrics."""
        import duckdb
        
        conn = duckdb.connect("data/analytics.duckdb", read_only=True)
        
        result = conn.execute("""
            SELECT *
            FROM analytics.int_combat_damage_analysis
            WHERE combat_session_id = ?
        """, (combat_session_id,)).fetchone()
        
        conn.close()
        
        if result:
            return {
                'total_damage': result[2],
                'avg_damage': result[3],
                'critical_hits': result[4],
                'max_combo': result[5],
                'combo_multiplier': result[7]
            }
        
        return {}
```

