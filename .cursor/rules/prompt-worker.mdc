### Batch Similar Prompts
```python
async def generate_multiple_dialogues(
    npcs: list[NPC],
    player_question: str
) -> list[NPCDialogueResponse]:
    """Generate dialogues for multiple NPCs in parallel."""
    tasks = [
        ai_manager.generate_npc_dialogue(npc, player_question)
        for npc in npcs
    ]
    return await asyncio.gather(*tasks)
