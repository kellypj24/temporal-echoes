def test_token_counting():
    """Test token estimation accuracy."""
    template = PromptTemplate(...)
    context = {'player_name': 'Test'}
    
    estimated = template.estimate_tokens(context)
    actual = len(template.render(context)) // 4
    
    assert abs(estimated - actual) < 10  # Within 10 tokens
