### Context Truncation Strategies

```python
class ContextTruncator:
    """Manage context window with intelligent truncation."""
    
    def __init__(self, max_tokens: int = 4096):
        self.max_tokens = max_tokens
    
    def truncate_context(
        self,
        prompt_template: str,
        context: PromptContext,
        reserve_tokens: int = 512  # For response
    ) -> PromptContext:
        """
        Truncate context to fit within token budget.
        
        Strategy:
        1. Keep most recent events
        2. Summarize older events
        3. Reduce specific context details if needed
        """
        available_tokens = self.max_tokens - reserve_tokens
        template_tokens = len(prompt_template) // 4
        remaining = available_tokens - template_tokens
        
        if remaining < 0:
            raise ValueError("Prompt template too large")
        
        # Truncate event history
        events = context.session_events
        truncated_events = []
        token_count = 0
        
        # Add events from most recent backwards
        for event in reversed(events):
            event_tokens = len(event) // 4
            if token_count + event_tokens <= remaining // 2:  # Reserve half for events
                truncated_events.insert(0, event)
                token_count += event_tokens
            else:
                break
        
        # Create truncated context
        truncated = PromptContext(
            player_name=context.player_name,
            player_level=context.player_level,
            player_location=context.player_location,
            timeline_id=context.timeline_id,
            session_events=truncated_events,
            specific=context.specific
        )
        
        return truncated
    
    def sliding_window(
        self,
        messages: list[str],
        window_size: int = 10
    ) -> list[str]:
        """
        Keep sliding window of most recent messages.
        
        Args:
            messages: Full message history
            window_size: Number of recent messages to keep
            
        Returns:
            Truncated message list
        """
        if len(messages) <= window_size:
            return messages
        
        return messages[-window_size:]
```

### Response Schema Definitions

```python
from pydantic import BaseModel, Field, validator

class CombatNarrativeResponse(BaseModel):
    """Validated combat narrative response."""
    description: str = Field(..., max_length=500)
    tone: str = Field(..., pattern="^(epic|tense|humorous|grim)$")
    length: int = Field(..., ge=1, le=150)
    
    @validator('description')
    def no_empty_description(cls, v):
        if not v.strip():
            raise ValueError("Description cannot be empty")
        return v

class NPCDialogueResponse(BaseModel):
    """Validated NPC dialogue response."""
    dialogue: str = Field(..., max_length=400)
    emotion: str = Field(..., pattern="^(happy|sad|angry|neutral|afraid)$")
    quest_hint: bool
    
    @validator('dialogue')
    def no_modern_slang(cls, v):
        # Basic check for modern slang
        forbidden = ['lol', 'omg', 'brb', 'gg']
        lower = v.lower()
        for word in forbidden:
            if word in lower:
                raise ValueError(f"Modern slang not allowed: {word}")
        return v

class QuestGenerationResponse(BaseModel):
    """Validated quest generation response."""
    quest_title: str = Field(..., max_length=50)
    quest_giver: str = Field(..., max_length=30)
    objective: str = Field(..., max_length=200)
    steps: list[str] = Field(..., min_items=1, max_items=5)
    reward: str = Field(..., max_length=100)
    estimated_time: str = Field(..., pattern="^(short|medium|long)$")

class LocationDescriptionResponse(BaseModel):
    """Validated location description response."""
    description: str = Field(..., max_length=400)
    mood: str = Field(..., pattern="^(peaceful|ominous|bustling|desolate)$")
    points_of_interest: list[str] = Field(default_factory=list, max_items=5)
```

