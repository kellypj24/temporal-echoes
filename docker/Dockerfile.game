# Temporal Echoes Game Container
# Python 3.13 with Pygame and dependencies

FROM python:3.13-slim

# Set working directory
WORKDIR /app

# Install system dependencies for Pygame
RUN apt-get update && apt-get install -y \
    # Pygame/SDL dependencies
    libsdl2-dev \
    libsdl2-image-dev \
    libsdl2-mixer-dev \
    libsdl2-ttf-dev \
    libfreetype6-dev \
    libportmidi-dev \
    libjpeg-dev \
    # For display support
    xvfb \
    x11-apps \
    # Utilities
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv from the official static binary image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Sync dependencies into the system Python (no separate venv inside the container)
ENV UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock ./

# Install runtime dependencies only (skip dev group, skip project itself for now)
RUN uv sync --frozen --no-dev --no-install-project

# Copy application code
COPY src/ ./src/
COPY dbt/ ./dbt/
COPY assets/ ./assets/

# Install the project itself
RUN uv sync --frozen --no-dev

# Ensure data directory exists
RUN mkdir -p /app/data

# Set Python path
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Default command
CMD ["python", "-m", "src.main"]
